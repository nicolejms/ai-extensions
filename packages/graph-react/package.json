{
  "name": "@radius-project/graph-react",
  "version": "0.1.0",
  "description": "Browser-safe Radius graph visualization for React applications.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./presentation": "./src/presentation.ts",
    "./styles.css": "./src/styles.css",
    "./base.css": "./src/base.css"
  },
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "presentation": [
        "dist/presentation.d.ts"
      ]
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./presentation": {
        "types": "./dist/presentation.d.ts",
        "import": "./dist/presentation.js",
        "default": "./dist/presentation.js"
      },
      "./styles.css": "./dist/styles.css",
      "./base.css": "./dist/base.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:component": "vitest run --config vitest.component.config.ts"
  },
  "dependencies": {
    "@radius-project/core": "workspace:*",
    "reactflow": "11.11.4"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.2.8",
    "react-dom": "^18.3.1 || ^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.6",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "^4.1.11",
    "dagre": "0.8.5",
    "playwright": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vitest": "catalog:"
  }
}
