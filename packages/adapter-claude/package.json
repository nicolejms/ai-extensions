{
  "name": "@radius-project/adapter-claude",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code MCP adapter and interactive Radius graph app.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:artifact": "node build.mjs && vitest run --config vitest.artifact.config.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" mcp-app.tsx build.mjs vitest.config.ts vitest.component.config.ts vitest.artifact.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@radius-project/adapter-shared": "workspace:*",
    "@radius-project/core": "workspace:*",
    "@radius-project/graph-react": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "^4.1.11",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "vitest": "catalog:"
  }
}
