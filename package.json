{
  "name": "ai-extensions",
  "private": true,
  "type": "module",
  "description": "Deploy with Radius - Copilot canvas extension",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @radius-project/adapter-canvas --filter @radius-project/adapter-claude run build",
    "watch": "pnpm --filter @radius-project/adapter-canvas run watch",
    "build:canvas": "pnpm --filter @radius-project/adapter-canvas run build",
    "build:claude": "pnpm --filter @radius-project/adapter-claude run build",
    "build:libraries": "node scripts/build-libraries.mjs",
    "test:integration:libraries": "node scripts/build-libraries.mjs && node scripts/test-libraries.mjs",
    "test:integration:headlamp": "node scripts/test-headlamp.mjs",
    "watch:canvas": "pnpm --filter @radius-project/adapter-canvas run watch",
    "build:install": "pnpm --filter @radius-project/adapter-canvas run build:install",
    "watch:dev": "pnpm --filter @radius-project/adapter-canvas run watch:dev",
    "typecheck": "tsc -p tsconfig.test.json && pnpm -r run --if-present typecheck",
    "test": "vitest run",
    "test:integration:windows-process": "pnpm --filter @radius-project/adapter-shared --filter @radius-project/adapter-canvas run test:integration:windows-process",
    "test:integration:runtime": "pnpm --filter @radius-project/adapter-canvas run test:integration:runtime",
    "test:integration:http": "pnpm --filter @radius-project/adapter-canvas run test:integration:http",
    "test:integration:artifact": "pnpm --filter @radius-project/adapter-canvas run test:integration:artifact && pnpm --filter @radius-project/adapter-claude run test:artifact",
    "test:component": "pnpm --filter @radius-project/adapter-canvas --filter @radius-project/graph-react --filter @radius-project/adapter-claude run test:component",
    "test:chromium": "playwright test --config packages/adapter-canvas/playwright.config.ts",
    "test:visual": "playwright test --config packages/adapter-canvas/playwright.visual.config.ts",
    "test:visual:stability": "playwright test --config packages/adapter-canvas/playwright.visual.config.ts --repeat-each=2 --retries=0",
    "test:visual:update": "playwright test --config packages/adapter-canvas/playwright.visual.config.ts --update-snapshots --retries=0",
    "test:visual:canonical": "node scripts/canvas-visual.mjs check",
    "test:visual:canonical:update": "node scripts/canvas-visual.mjs update",
    "test:reliability": "pnpm --filter @radius-project/adapter-canvas run test:reliability",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint eslint.config.mjs \"packages/**/*.{ts,tsx,mjs}\" \"extensions/radius/skills/**/*.mjs\" \"scripts/**/*.mjs\" vitest.config.ts",
    "format": "prettier --config .github/linters/.prettierrc.yml --write eslint.config.mjs \"packages/**/*.{ts,tsx,mjs}\" \"extensions/radius/skills/**/*.mjs\" \"scripts/**/*.mjs\" vitest.config.ts",
    "format:check": "prettier --config .github/linters/.prettierrc.yml --check eslint.config.mjs \"packages/**/*.{ts,tsx,mjs}\" \"extensions/radius/skills/**/*.mjs\" \"scripts/**/*.mjs\" vitest.config.ts",
    "lint:md": "markdownlint-cli2 --config ./.github/linters/.markdownlint-cli2.yaml \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --config ./.github/linters/.markdownlint-cli2.yaml --fix \"**/*.md\"",
    "changeset": "changeset",
    "version": "node scripts/release-version.mjs",
    "version:libraries": "node scripts/release-version.mjs --libraries",
    "version:sync": "node scripts/version.mjs --sync",
    "version:check": "node scripts/version.mjs --check",
    "demo:progress": "node packages/adapter-canvas/dev/run-demo.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "catalog:",
    "@types/react18": "npm:@types/react@^18.3.1",
    "@types/react-dom18": "npm:@types/react-dom@^18.3.1",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "markdown-table-formatter": "1.7.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "^3.9.6",
    "react18": "npm:react@18.3.1",
    "react-dom18": "npm:react-dom@18.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
